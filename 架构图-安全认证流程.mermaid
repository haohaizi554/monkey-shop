%% MonkeyShop 安全认证流程图
%% 展示用户/管理员双轨认证体系
flowchart TB
    subgraph AuthFlow["认证流程"]
        direction TB
        Request["HTTP 请求到达"] --> SecFilter["Spring Security 过滤器链<br/>CSRF: OFF / permitAll"]
        SecFilter --> Dispatcher["DispatcherServlet"]
        Dispatcher --> ControllerCheck{"Controller 层<br/>Session 权限检查"}
        ControllerCheck -->|"未登录"| Reject["返回 401/重定向"]
        ControllerCheck -->|"IDENTITY=USER"| UserAPI["用户 API"]
        ControllerCheck -->|"IDENTITY=ADMIN"| AdminAPI["管理员 API"]
    end

    subgraph LoginFlow["登录流程"]
        direction TB
        LoginForm["登录表单<br/>username + password"] --> LoginAPI["POST /api/auth/login"]
        LoginAPI --> UserType{"用户类型?"}
        UserType -->|"普通用户"| QueryUser["UserRepository<br/>findByUsername()"]
        UserType -->|"管理员"| QueryAdmin["AdminRepository<br/>findByUsername()"]
        QueryUser --> BCrypt["BCrypt.matches()<br/>密码比对"]
        QueryAdmin --> BCrypt
        BCrypt -->|"失败"| LoginFail["返回错误信息"]
        BCrypt -->|"成功"| SetSession["Session 写入"]
        SetSession --> RoleCheck{"角色?"}
        RoleCheck -->|"USER"| SetUser["USER_ID + IDENTITY=USER"]
        RoleCheck -->|"ADMIN"| SetAdmin["ADMIN_ID + IDENTITY=ADMIN"]
        SetUser --> RedirectShop["重定向 → shop.html"]
        SetAdmin --> RedirectAdmin["重定向 → admin.html"]
    end

    subgraph CaptchaFlow["验证码流程"]
        direction TB
        CaptchaReq["GET /api/user/captcha"] --> Generate["CaptchaUtil.generate()<br/>Graphics2D 绘制"]
        Generate --> FontRender["字体渲染<br/>Docker: Liberation/DejaVu<br/>Local: Arial"]
        FontRender --> SaveCode["CaptchaService.save()<br/>存入 Session"]
        SaveCode --> ReturnImg["返回 PNG 图片流"]
        ReturnImg --> UserInput["用户输入验证码"]
        UserInput --> Verify["CaptchaService.verify()<br/>对比后立即销毁"]
        Verify -->|"正确"| Continue["继续注册/重置"]
        Verify -->|"错误"| CaptchaFail["返回错误"]
    end

    subgraph PasswordFlow["密码安全"]
        direction TB
        RawPwd["明文密码"] --> BCryptHash["BCrypt 加密<br/>强度: 10 rounds"]
        BCryptHash --> StoredPwd["存储加密后密码"]
        LoginVerify["登录验证"] --> BCryptMatch["BCrypt.matches()"]
        ResetPwd["重置密码"] --> PhoneVerify["手机号验证"]
        PhoneVerify --> BCryptHash
    end

    AuthFlow --> LoginFlow
    LoginFlow -.-> CaptchaFlow
    LoginFlow -.-> PasswordFlow

    classDef process fill:#01579b,stroke:#00e5ff,stroke-width:2px,color:#e1f5fe
    classDef decision fill:#f57f17,stroke:#ffeb3b,stroke-width:2px,color:#fffde7
    classDef success fill:#1b5e20,stroke:#66bb6a,stroke-width:2px,color:#e8f5e9
    classDef error fill:#b71c1c,stroke:#ef5350,stroke-width:2px,color:#ffebee
    classDef storage fill:#4a148c,stroke:#ea80fc,stroke-width:3px,color:#f3e5f5

    Request:::process
    SecFilter:::process
    Dispatcher:::process
    ControllerCheck:::decision
    Reject:::error
    UserAPI:::success
    AdminAPI:::success
    LoginForm:::process
    LoginAPI:::process
    UserType:::decision
    QueryUser:::process
    QueryAdmin:::process
    BCrypt:::process
    LoginFail:::error
    SetSession:::process
    RoleCheck:::decision
    SetUser:::success
    SetAdmin:::success
    RedirectShop:::success
    RedirectAdmin:::success
    Generate:::process
    FontRender:::process
    SaveCode:::process
    ReturnImg:::process
    UserInput:::process
    Verify:::decision
    Continue:::success
    CaptchaFail:::error
    RawPwd:::process
    BCryptHash:::process
    StoredPwd:::storage
    LoginVerify:::process
    BCryptMatch:::process
    ResetPwd:::process
    PhoneVerify:::process
