%% MonkeyShop 容器化部署架构图
%% 展示 Docker Compose 编排、网络、存储、启动流程
flowchart TB
    subgraph Host["宿主机 (Ubuntu Server)"]
        direction TB

        subgraph DockerEngine["Docker Engine"]
            direction TB

            subgraph Network["Docker Bridge Network"]
                direction TB

                subgraph AppContainer["monkey-app 容器"]
                    direction TB
                    Entrypoint["entrypoint.sh<br/>① 解压默认图片 → /data/images/<br/>② exec java -jar app.jar"]
                    JRE["OpenJDK 21 JRE"]
                    App["Spring Boot 3.2<br/>MonkeyShopApplication"]
                    Fonts["字体库<br/>DejaVu + Liberation"]
                    TZ_App["TZ=Asia/Shanghai"]

                    Entrypoint --> JRE --> App
                end

                subgraph MySQLContainer["monkey-mysql 容器"]
                    direction TB
                    MySQL["MySQL 8.0 Server"]
                    InitDB["初始化脚本<br/>CREATE DATABASE monkeyshop<br/>CREATE USER monkeyuser"]
                    CharSet["--character-set-server=utf8mb4<br/>--collation-server=utf8mb4_unicode_ci<br/>--default-time-zone=+08:00"]
                    TZ_DB["TZ=Asia/Shanghai"]
                    HealthCheck["健康检查<br/>mysqladmin ping<br/>timeout: 20s / retries: 10"]

                    MySQL --> InitDB
                    MySQL --> CharSet
                    HealthCheck -.->|"liveness"| MySQL
                end
            end

            App -->|"JDBC<br/>mysql:3306"| MySQL
        end

        subgraph Volumes["数据持久化"]
            direction LR
            BindMount["绑定挂载<br/>./uploads ↔ /data/images<br/>(用户上传的图片)"]
            NamedVol["命名卷<br/>mysql_data ↔ /var/lib/mysql<br/>(数据库文件)"]
        end

        subgraph EnvConfig["配置管理"]
            direction LR
            EnvFile[".env 文件<br/>(密码等敏感信息)<br/>❌ 已加入 .gitignore"]
            ComposeEnv["docker-compose.yml<br/>环境变量注入<br/>SPRING_DATASOURCE_*<br/>APP_UPLOAD_PATH<br/>SPRING_JPA_SHOW_SQL=false"]
        end

        subgraph Ports["端口映射"]
            direction LR
            Port8888["8888:8888<br/>Web 应用"]
            Port3307["3307:3306<br/>MySQL (避免冲突)"]
        end
    end

    User["👤 用户"] -->|"HTTP :8888"| Port8888
    Port8888 --> App
    Port3307 --> MySQL

    AppContainer --> BindMount
    MySQLContainer --> NamedVol

    EnvFile --> ComposeEnv
    ComposeEnv --> AppContainer
    ComposeEnv --> MySQLContainer

    MySQLContainer -->|"service_healthy"| AppContainer

    classDef container fill:#0d47a1,stroke:#42a5f5,stroke-width:2px,color:#e3f2fd
    classDef storage fill:#4a148c,stroke:#ea80fc,stroke-width:3px,color:#f3e5f5
    classDef config fill:#1b5e20,stroke:#66bb6a,stroke-width:2px,color:#e8f5e9
    classDef network fill:#e65100,stroke:#ffab40,stroke-width:2px,color:#fff3e0
    classDef process fill:#37474f,stroke:#b0bec5,stroke-width:2px,color:#eceff1
    classDef actor fill:#bf360c,stroke:#ffab91,stroke-width:2px,color:#fff

    AppContainer:::container
    MySQLContainer:::container
    BindMount:::storage
    NamedVol:::storage
    EnvFile:::config
    ComposeEnv:::config
    Port8888:::network
    Port3307:::network
    Network:::network
    Entrypoint:::process
    App:::process
    MySQL:::process
    User:::actor
