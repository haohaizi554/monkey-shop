%% MonkeyShop 部署流水线图
%% 展示从代码提交到生产部署的完整 CI/CD 流程
flowchart LR
    subgraph Dev["开发环境 (Windows/Mac)"]
        direction TB
        Code["💻 编写代码<br/>Spring Boot + Vue 3"]
        Git["📝 git commit & push<br/>→ GitHub"]
        Code --> Git
    end

    subgraph Build["构建环境 (Ubuntu)"]
        direction TB
        Clone["⬇️ git clone<br/>github.com/haohaizi554/monkey-shop"]
        Compile["🔨 mvn clean package<br/>-DskipTests"]
        Jar["📦 target/*.jar<br/>~60MB"]
        Clone --> Compile --> Jar
    end

    subgraph DockerBuild["Docker 构建"]
        direction TB
        BaseImg["FROM openjdk:21-jdk-slim<br/>(华为云 SWR 加速)"]
        AptMirror["APT → 阿里云源"]
        Fonts["安装字体库<br/>DejaVu + Liberation"]
        Timezone["TZ=Asia/Shanghai"]
        CopyJar["COPY target/*.jar app.jar"]
        Entrypoint["COPY entrypoint.sh"]
        BaseImg --> AptMirror --> Fonts --> Timezone --> CopyJar --> Entrypoint
    end

    subgraph Compose["Docker Compose 编排"]
        direction TB
        subgraph MySQLSvc["MySQL 服务"]
            MImg["mysql:8.0"]
            MHealth["健康检查<br/>mysqladmin ping"]
            MVol["mysql_data 卷"]
            MImg --> MHealth --> MVol
        end
        subgraph AppSvc["App 服务"]
            AImg["构建 Dockerfile"]
            ADep["depends_on:<br/>mysql: service_healthy"]
            AVol["./uploads ↔ /data/images"]
            AImg --> ADep --> AVol
        end
        MHealth -->|"healthy"| ADep
    end

    subgraph Runtime["运行时"]
        direction TB
        Start["entrypoint.sh"]
        InitImg["初始化默认图片<br/>unzip → cp -rn"]
        JavaApp["java -jar app.jar"]
        Spring["Spring Boot 启动<br/>端口 8888"]
        Start --> InitImg --> JavaApp --> Spring
    end

    subgraph Prod["生产访问"]
        direction TB
        User["👤 用户浏览器"]
        Nginx["🌐 http://IP:8888"]
        App["MonkeyShop 应用"]
        User --> Nginx --> App
    end

    Dev --> Build --> DockerBuild --> Compose --> Runtime --> Prod

    classDef dev fill:#1b5e20,stroke:#66bb6a,stroke-width:2px,color:#e8f5e9
    classDef build fill:#0d47a1,stroke:#42a5f5,stroke-width:2px,color:#e3f2fd
    classDef docker fill:#e65100,stroke:#ffab40,stroke-width:2px,color:#fff3e0
    classDef runtime fill:#4a148c,stroke:#ea80fc,stroke-width:2px,color:#f3e5f5
    classDef prod fill:#b71c1c,stroke:#ef5350,stroke-width:2px,color:#ffebee
    classDef process fill:#37474f,stroke:#b0bec5,stroke-width:2px,color:#eceff1

    Code:::dev
    Git:::dev
    Clone:::build
    Compile:::build
    Jar:::build
    BaseImg:::docker
    AptMirror:::docker
    Fonts:::docker
    Timezone:::docker
    CopyJar:::docker
    Entrypoint:::docker
    MImg:::docker
    MHealth:::docker
    MVol:::docker
    AImg:::docker
    ADep:::docker
    AVol:::docker
    Start:::runtime
    InitImg:::runtime
    JavaApp:::runtime
    Spring:::runtime
    User:::prod
    Nginx:::prod
    App:::prod
