# Loaded after the repository .env by scripts/start-local.ps1.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://127.0.0.1:3306/monkeyshop_dev?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&sslMode=REQUIRED&allowPublicKeyRetrieval=true
DB_USERNAME=monkeyuser
DB_PASSWORD=<local-mysql-password>
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SERVER_PORT=8888
APP_STORAGE_PROVIDER=local
APP_UPLOAD_VIRUS_SCAN_ENABLED=false
APP_PASSWORD_HIBP_ENABLED=false
APP_JWT_REQUIRE_REDIS_TOKEN_STORE=true
APP_AUTH_REQUIRE_REDIS_STATE=true
APP_RATE_LIMIT_REQUIRE_REDIS_STATE=true
SESSION_COOKIE_SECURE=false
APP_JWT_COOKIE_SECURE=false
APP_AUTH_CAPTCHA_COOKIE_SECURE=false
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
