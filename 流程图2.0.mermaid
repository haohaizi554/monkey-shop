flowchart TB
 subgraph Auth_Core["CORE: 认证与安全"]
    direction TB
        Login["登录接口"]
        Register["注册流程"]
        ResetPwd["找回密码"]
        Captcha{"验证码校验"}
        Security["Spring Security"]
        BCrypt["BCrypt 加密"]
        Session["Session/Token"]
        Interceptor["全局拦截器"]
  end
 subgraph Browse["浏览模块 (Table: monkey)"]
    direction TB
        Home["商城首页"]
        Banner["轮播图"]
        Search["搜索/筛选"]
        ProductList["商品列表"]
        StockCheck{"库存检查"}
  end
 subgraph Trade["交易模块 (Table: orders/address)"]
    direction TB
        BuyModal["购买弹窗"]
        AddressSelect["选择地址"]
        AddAddress["lin新增地址"]
        SubmitOrder["提交订单"]
        DeductStock["原子扣减库存"]
        CreateSnapshot["生成快照"]
  end
 subgraph Order_Actions["订单操作"]
    direction LR
        CompleteOrder["确认收货"]
        ApplyReturn["申请退货"]
        ShipReturn["退货发货"]
  end
 subgraph UserCenter["个人中心 (Table: user)"]
    direction TB
        Profile["个人资料"]
        AvatarUpload["头像上传"]
        AddressManage["地址管理"]
        SecuritySetting["账号安全"]
        MyOrders["我的订单"]
        Order_Actions
  end
 subgraph Main_Business["FRONT: 商城前台业务"]
    direction TB
        Browse
        Trade
        UserCenter
  end
 subgraph Goods_Ops["商品管理 (Table: monkey)"]
    direction TB
        ProductManage["商品列表管理"]
        SaveProduct["保存/更新商品"]
        AutoCrop["图片自动裁剪"]
        DeleteProduct["删除/下架"]
  end
 subgraph Order_Ops["订单管理 (Table: orders)"]
    direction TB
        OrderManage["订单列表管理"]
        ShipOrder["确认发货"]
        ApproveReturn["同意退货"]
        ConfirmRefund["确认退款"]
        RestoreStock["库存回滚"]
        DeleteOrder["删除订单"]
  end
 subgraph Admin_System["BACK: 后台管理系统"]
    direction TB
        Dashboard["数据看板"]
        StatsData["统计计算"]
        Goods_Ops
        Order_Ops
  end
 subgraph Background_Tasks["SYSTEM: 守护进程"]
    direction LR
        ScheduledTask["定时任务(Cron)"]
        ImageScan["孤儿图片扫描"]
        ImageCleanup["GC 垃圾回收"]
  end
 subgraph Persistence["DATA: 存储与日志"]
    direction LR
        DB[("MySQL 主库<br>(user, monkey, address)")]
        OrderRecord[("订单表<br>(orders)")]
        VisitLog[("访问日志<br>(visit_log)")]
        FileSystem[("文件系统<br>(Images/Avatars)")]
  end
    User[["[User] 用户"]] ==> Login & Register & ResetPwd & Home & Profile & MyOrders
    Admin[["[Admin] 管理员"]] ==> Login & Dashboard & ProductManage & OrderManage
    Register --> Captcha
    ResetPwd --> Captcha
    Login --> BCrypt
    Captcha -- Pass --> DB
    BCrypt -- Pass --> Session
    Session --> Interceptor
    Interceptor -.-> Admin_System & VisitLog
    Home --> Banner & ProductList & Search
    Search --> ProductList
    ProductList -- 选中 --> StockCheck
    StockCheck -- 有货 --> BuyModal
    BuyModal --> AddressSelect
    AddressSelect -- 无数据 --> AddAddress
    AddAddress -- Insert --> DB
    AddressSelect -- 确认 --> SubmitOrder
    SubmitOrder --> DeductStock
    DeductStock -- 成功 --> CreateSnapshot
    CreateSnapshot -- Insert --> OrderRecord
    OrderRecord -.-> DB
    Profile --> AvatarUpload & AddressManage & SecuritySetting
    AvatarUpload -- File --> FileSystem
    AvatarUpload -- Path --> DB
    AvatarUpload -.-> ImageCleanup
    MyOrders --> OrderRecord & CompleteOrder & ApplyReturn & ShipReturn
    CompleteOrder --> DB
    ShipReturn --> DB
    Dashboard --> StatsData
    StatsData --> DB & VisitLog
    ProductManage --> SaveProduct & DeleteProduct
    ProductManage -- Upload --> AutoCrop
    AutoCrop --> FileSystem
    SaveProduct --> DB
    DeleteProduct --> DB
    DeleteProduct -.-> ImageCleanup
    OrderManage --> ShipOrder & ApproveReturn & ConfirmRefund & DeleteOrder
    ShipOrder --> DB
    ConfirmRefund --> RestoreStock
    DeleteOrder --> RestoreStock
    RestoreStock --> DB
    DeleteOrder -.-> ImageCleanup
    ScheduledTask --> ImageScan
    ImageScan -- Read --> DB
    ImageScan -- Compare --> FileSystem
    ImageScan -- Delete --> ImageCleanup
    ImageCleanup --> FileSystem

     Login:::terminal
     Register:::terminal
     ResetPwd:::terminal
     Captcha:::decision
     Security:::process
     BCrypt:::process
     Session:::process
     Interceptor:::process
     Home:::terminal
     Banner:::terminal
     Search:::terminal
     ProductList:::terminal
     StockCheck:::decision
     BuyModal:::terminal
     AddressSelect:::terminal
     AddAddress:::terminal
     SubmitOrder:::process
     DeductStock:::process
     CreateSnapshot:::process
     CompleteOrder:::process
     ApplyReturn:::process
     ShipReturn:::process
     Profile:::terminal
     AvatarUpload:::terminal
     AddressManage:::terminal
     SecuritySetting:::terminal
     MyOrders:::terminal
     ProductManage:::terminal
     SaveProduct:::process
     AutoCrop:::process
     DeleteProduct:::process
     OrderManage:::terminal
     ShipOrder:::process
     ApproveReturn:::process
     ConfirmRefund:::process
     RestoreStock:::process
     DeleteOrder:::process
     Dashboard:::terminal
     StatsData:::terminal
     ScheduledTask:::process
     ImageScan:::process
     ImageCleanup:::process
     DB:::storage
     OrderRecord:::storage
     VisitLog:::storage
     FileSystem:::storage
     User:::actor
     Admin:::actor
    classDef terminal fill:#37474f,stroke:#b0bec5,stroke-width:2px,rx:0,ry:0,color:#eceff1
    classDef process fill:#01579b,stroke:#00e5ff,stroke-width:2px,rx:0,ry:0,color:#e1f5fe
    classDef decision fill:#f57f17,stroke:#ffeb3b,stroke-width:2px,rx:0,ry:0,shape:rhombus,color:#fffde7
    classDef storage fill:#4a148c,stroke:#ea80fc,stroke-width:3px,rx:0,ry:0,shape:cyl,color:#f3e5f5
    classDef actor fill:#bf360c,stroke:#ffab91,stroke-width:2px,rx:0,ry:0,shape:rect,color:#fff