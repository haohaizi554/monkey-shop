---
config:
  layout: dagre
---
graph TD
    User((用户)) -->|访问| IndexPage["用户登录首页<br>index.html"]
    Admin((管理员)) -->|访问| IndexPage
    subgraph "认证与安全 (Auth & Security)"
        IndexPage -->|注册| RegisterAPI["POST /api/auth/register"]
        IndexPage -->|登录| LoginAPI["POST /api/auth/login"]
        IndexPage -->|找回密码| ResetPwdAPI["POST /api/auth/reset-password"]
        
        RegisterAPI -->|校验| CaptchaService{"验证码校验"}
        LoginAPI -->|校验| BCrypt{"密码比对"}
        ResetPwdAPI -->|校验| PhoneCheck{"手机号验证"}
        
        CaptchaService -->|失败| ErrorMsg["返回错误信息"]
        BCrypt -->|失败| ErrorMsg
        PhoneCheck -->|失败| ErrorMsg
        
        CaptchaService -->|成功| DB_User[("User表")]
        BCrypt -->|成功| Session["生成 Session"]
        PhoneCheck -->|成功| UpdatePwd["更新密码"]
    end
    Session -->|Role=USER| ShopPage["商城首页<br>shop.html"]
    Session -->|Role=ADMIN| AdminPage["管理后台<br>admin.html"]
    subgraph "用户购物 (Shopping)"
        ShopPage -->|浏览商品| MonkeyList["GET /api/monkeys"]
        ShopPage -->|搜索/筛选| Filter["前端实时过滤"]
        
        Filter -->|点击购买| BuyModal["购买弹窗"]
        BuyModal -->|选择地址| AddressList["GET /api/address"]
        BuyModal -->|新增地址| AddAddressAPI["POST /api/address"]
        
        BuyModal -->|确认支付| CreateOrderAPI["POST /api/orders/create"]
        
        CreateOrderAPI -->|1. 检查库存| StockCheck{"库存 > 0 ?"}
        StockCheck -->|否| OrderFail["下单失败"]
        StockCheck -->|是| DeductStock["原子扣减库存"]
        DeductStock -->|2. 生成快照| OrderSnapshot["保存订单快照<br>(商品/买家/地址)"]
        OrderSnapshot -->|3. 写入数据库| DB_Order[("Order表")]
    end
    subgraph "订单全生命周期 (Order Lifecycle)"
        DB_Order -->|状态: 已支付| AdminShip["管理员发货"]
        AdminShip -->|POST /ship| ShipAPI["更新状态: 已发货<br>记录发货时间"]
        
        ShipAPI -->|用户操作| UserReceive["用户确认收货"]
        UserReceive -->|POST /receive| ReceiveAPI["更新状态: 已完成"]
        
        ReceiveAPI -->|用户操作| UserReturn["申请退货"]
        UserReturn -->|POST /return/apply| ReturnApplyAPI["状态: 申请退货"]
        
        ReturnApplyAPI -->|管理员操作| AdminApprove["同意退货"]
        AdminApprove -->|POST /return/approve| ReturnApproveAPI["状态: 待退货发货"]
        
        ReturnApproveAPI -->|用户操作| UserShipReturn["用户已发货"]
        UserShipReturn -->|POST /return/ship| ReturnShipAPI["状态: 退货中"]
        
        ReturnShipAPI -->|管理员操作| AdminConfirmReturn["确认收到退货"]
        AdminConfirmReturn -->|POST /return/confirm| RefundAPI["状态: 已退款"]
        
        RefundAPI -->|触发| RestoreStock["库存 +1"]
        RestoreStock --> DB_Monkey[("Monkey表")]
    end
    subgraph "后台管理 (Admin Management)"
        AdminPage -->|数据看板| StatsAPI["GET /api/stats/data"]
        StatsAPI -->|统计| ECharts["渲染图表"]
        
        AdminPage -->|商品管理| ProductCRUD["增删改查商品"]
        ProductCRUD -->|上传图片| UploadAPI["POST /api/upload"]
        UploadAPI -->|处理| ImageCrop{"自动裁剪?"}
        ImageCrop -->|是| SaveImg["保存并返回路径"]
        
        AdminPage -->|删除订单| DeleteOrderAPI["DELETE /api/orders/{id}"]
        DeleteOrderAPI -->|未完成订单| RestoreStock
        DeleteOrderAPI -->|清理图片| ImageCleanup{"引用计数检查"}
        ImageCleanup -->|计数=0| DeleteFile["物理删除图片"]
    end
    subgraph "系统维护 (System Maintenance)"
        Scheduler["定时任务<br>ImageTask"] -->|每天凌晨| ScanFiles["扫描硬盘图片"]
        ScanFiles -->|对比数据库| CheckOrphan{"是否孤儿文件?"}
        CheckOrphan -->|是| RealDelete["物理删除"]
    end
    DB_User <--> LoginAPI
    DB_Monkey <--> MonkeyList
    DB_Monkey <--> StockCheck
    DB_Order <--> StatsAPI